############ THEME ############
# Catppuccin Theme
#theme = "light:catppuccin-latte.conf,dark:catppuccin-mocha.conf"
# EverforestTheme
theme = "light:everforest-light-medium.conf,dark:everforest-dark-medium.conf"

############ Font ############
# font-family = "LiterationMono Nerd Font Mono"
#font-family = "SpaceMono Nerd Font Mono"
#font-family = "Monaspace Argon NF"
font-family = "Monaspace Neon NF"
font-size = 14
adjust-cell-height = 15%

############ General ############
# Cursor
shell-integration-features = no-cursor
cursor-style = block

############ Keybindings ############
# Better pane switching
keybind = ctrl+tab=goto_split:next
keybind = ctrl+shift+tab=goto_split:previous
# Better screen clearing
keybind = ctrl+shift+l=clear_screen
# Vim keybindings to switch between panes
keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:bottom
keybind = ctrl+k=goto_split:top
keybind = ctrl+l=goto_split:right
